<Application x:Class="Marco.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Marco.App">
  <Application.Resources>
    <ResourceDictionary>

      <local:StatusToBrushConverter x:Key="StatusToBrush" />
      <local:BytesToGbConverter x:Key="BytesToGb" />
      <local:BoolToVisibilityConverter x:Key="BoolToVis" />
      <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />

      <!-- Neutral, theme-agnostic palette so the tool reads as one surface. -->
      <SolidColorBrush x:Key="PanelBrush" Color="#F5F6F8" />
      <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
      <SolidColorBrush x:Key="AccentBrush" Color="#2A6FB0" />
      <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

      <Style TargetType="TextBlock" x:Key="SectionHeader">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="#333" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="72" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
