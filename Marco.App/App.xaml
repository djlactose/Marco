<Application x:Class="Marco.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- SharedResources holds the converters/palette/styles; the detail template dictionary merges it
             itself as well, so its StaticResource references resolve in its own scope. -->
        <ResourceDictionary Source="Views/SharedResources.xaml" />
        <ResourceDictionary Source="Views/MachineDetailResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
