<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="SharedResources.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- One machine's full detail view, shared verbatim by MainWindow's bottom pane and MachineDetailWindow
       (the full-screen viewer). The DataContext is the LIVE Machine instance: NotifyInventoryUpdated re-raises
       everything after a host completes, and because collectors ASSIGN new list instances (see Machine.cs),
       the ItemsControls below re-render on that notification. -->
  <DataTemplate x:Key="MachineDetailTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
      <StackPanel>
        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusDetail}" Foreground="Firebrick" FontSize="11"
                   TextWrapping="Wrap" Margin="0,2,0,0"
                   Visibility="{Binding StatusDetail, Converter={StaticResource NotEmptyToVis}}" />
        <TextBlock Text="{Binding CurrentActivity}" Foreground="{StaticResource AccentBrush}" FontStyle="Italic"
                   FontSize="11" Margin="0,2,0,0"
                   Visibility="{Binding CurrentActivity, Converter={StaticResource NotEmptyToVis}}" />

        <!-- Prerequisite doctor: why inventory failed, with the copy-paste fix. Collapsed while the diagnosis
             title is empty (Cause None); Machine.Diagnosis recomputes on the row's RaiseAll. -->
        <!-- FallbackValue on every visibility: a null DataContext (no row selected) must collapse the panel,
             not show it — a failed binding otherwise leaves Visibility at its Visible default. -->
        <Border Background="#FDF3F2" BorderBrush="#E4B4AF" BorderThickness="1" CornerRadius="3"
                Padding="8,6" Margin="0,6,0,0"
                Visibility="{Binding Diagnosis.Title, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Why this failed:" FontWeight="SemiBold" FontSize="11" Foreground="#8B1A12" />
              <TextBlock Text="{Binding Diagnosis.Title}" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,0" />
              <TextBlock Text="(likely)" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0"
                         Visibility="{Binding Diagnosis.Confident, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}" />
            </StackPanel>
            <TextBlock Text="{Binding Diagnosis.Explanation}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBox Text="{Binding Diagnosis.FixScript, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Background="White"
                     BorderBrush="{StaticResource BorderBrush}" Margin="0,4,0,0"
                     Visibility="{Binding Diagnosis.FixScript, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />
            <Button Content="Copy fix" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" MinWidth="0"
                    Command="{StaticResource CopyText}" CommandParameter="{Binding Diagnosis.FixScript}"
                    Visibility="{Binding Diagnosis.FixScript, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />
          </StackPanel>
        </Border>

        <UniformGrid Columns="2" Margin="0,10,0,0">
          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Identity" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Address, StringFormat='IP: {0}'}" />
            <TextBlock Text="{Binding Fqdn, StringFormat='FQDN: {0}'}"
                       Visibility="{Binding Fqdn, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding PrimaryMac, StringFormat='MAC: {0}'}"
                       Visibility="{Binding PrimaryMac, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Vendor, StringFormat='Vendor: {0}'}"
                       Visibility="{Binding Vendor, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding DeviceType, StringFormat='Type: {0}'}" />
            <TextBlock Text="{Binding System.Domain, StringFormat='Domain: {0}'}"
                       Visibility="{Binding System.Domain, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Discovery" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding DiscoveryMethod, StringFormat='Method: {0}'}" />
            <TextBlock Text="{Binding IcmpTtl, StringFormat='TTL: {0}'}"
                       Visibility="{Binding IcmpTtl, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding OpenPortsDisplay, StringFormat='Open ports: {0}'}"
                       TextWrapping="Wrap"
                       Visibility="{Binding OpenPortsDisplay, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding LastScanned, StringFormat='Scanned: {0:HH:mm:ss}'}" />
            <TextBlock Text="{Binding Os.Caption, StringFormat='OS: {0}'}"
                       Visibility="{Binding Os.Caption, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
        </UniformGrid>

        <!-- Inventory (populated after Inventory selected/alive) -->
        <Separator Margin="0,10" />

        <UniformGrid Columns="2">
          <StackPanel Margin="0,0,20,0"
                      Visibility="{Binding System.Manufacturer, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="System" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding System.Manufacturer, StringFormat='Manufacturer: {0}'}" />
            <TextBlock Text="{Binding System.Model, StringFormat='Model: {0}'}" />
            <TextBlock Text="{Binding System.SerialNumber, StringFormat='Serial: {0}'}" />
            <TextBlock Text="{Binding System.ChassisType, StringFormat='Chassis: {0}'}" />
            <TextBlock Text="{Binding System.BiosVersion, StringFormat='BIOS: {0}'}" />
            <TextBlock Text="{Binding System.MotherboardModel, StringFormat='Board: {0}'}" />
            <TextBlock Text="{Binding System.CurrentOrLastUser, StringFormat='User: {0}'}"
                       Visibility="{Binding System.CurrentOrLastUser, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
          <StackPanel Visibility="{Binding Os.Caption, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="Operating system" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Os.Caption}" />
            <TextBlock Text="{Binding Os.Version, StringFormat='Version {0}'}" />
            <TextBlock Text="{Binding Os.Build, StringFormat='Build {0}'}" />
            <TextBlock Text="{Binding Os.Architecture}" />
            <TextBlock Text="{Binding Os.InstallDate, StringFormat='Installed {0:yyyy-MM-dd}'}" />
            <TextBlock Text="{Binding Os.UptimeDisplay, StringFormat='Uptime {0}'}"
                       Visibility="{Binding Os.UptimeDisplay, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
        </UniformGrid>

        <!-- Updates & servicing / Security posture -->
        <UniformGrid Columns="2" Margin="0,10,0,0">
          <StackPanel Margin="0,0,20,0"
                      Visibility="{Binding Updates.HasData, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="Updates &amp; servicing" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Updates.BuildSummary}" TextWrapping="Wrap"
                       Visibility="{Binding Updates.BuildSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.EditionId, StringFormat='Edition: {0}'}"
                       Visibility="{Binding Updates.EditionId, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.HotfixSummary}"
                       Visibility="{Binding Updates.HotfixSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.PendingRebootReasons, StringFormat='Pending reboot: {0}'}" Foreground="Firebrick" FontWeight="SemiBold"
                       Visibility="{Binding Updates.PendingRebootReasons, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.WsusDisplay, StringFormat='WSUS: {0}'}"
                       Visibility="{Binding Updates.WsusDisplay, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.AutoUpdateOption, StringFormat='Automatic Updates: {0}'}"
                       Visibility="{Binding Updates.AutoUpdateOption, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Updates.Notes}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding Updates.Notes, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
          <StackPanel Visibility="{Binding Security.HasData, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="Security posture" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding AntivirusSummary, StringFormat='Antivirus: {0}'}" TextWrapping="Wrap"
                       Visibility="{Binding AntivirusSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.DefenderSummary, StringFormat='Defender: {0}'}" TextWrapping="Wrap"
                       Visibility="{Binding Security.DefenderSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.FirewallSummary, StringFormat='Firewall: {0}'}"
                       Visibility="{Binding Security.FirewallSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.BitLockerSummary, StringFormat='BitLocker: {0}'}" TextWrapping="Wrap"
                       Visibility="{Binding Security.BitLockerSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.PlatformSummary, StringFormat='Platform: {0}'}"
                       Visibility="{Binding Security.PlatformSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.RdpSummary, StringFormat='Remote Desktop: {0}'}"
                       Visibility="{Binding Security.RdpSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.SmbSummary, StringFormat='SMB: {0}'}"
                       Visibility="{Binding Security.SmbSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.UacSummary, StringFormat='UAC: {0}'}"
                       Visibility="{Binding Security.UacSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.VbsSummary, StringFormat='VBS: {0}'}"
                       Visibility="{Binding Security.VbsSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.LapsSummary, StringFormat='LAPS: {0}'}"
                       Visibility="{Binding Security.LapsSummary, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Text="{Binding Security.Notes}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                       Visibility="{Binding Security.Notes, Converter={StaticResource NotEmptyToVis}}" />
          </StackPanel>
        </UniformGrid>

        <!-- Compliance (rule evaluation; see Marco.Core.Compliance) -->
        <StackPanel Visibility="{Binding ComplianceDisplay, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}">
          <TextBlock Text="Compliance" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
          <TextBlock>
            <Run Text="{Binding ComplianceDisplay, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run
              Text="{Binding Compliance.PassCount, Mode=OneWay}" /><Run Text=" pass, " /><Run
              Text="{Binding Compliance.UnknownCount, Mode=OneWay}" /><Run Text=" unknown" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Compliance.Failures}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#8B1A12">
                  <Run Text="✗" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Severity, Mode=OneWay}" /><Run Text="{Binding Detail, Mode=OneWay, StringFormat=' · {0}'}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Lifecycle (OS end-of-support + hardware age) -->
        <StackPanel Visibility="{Binding Lifecycle, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}">
          <TextBlock Text="Lifecycle" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
          <TextBlock Text="{Binding Lifecycle.SupportSummary}" TextWrapping="Wrap"
                     Visibility="{Binding Lifecycle.SupportSummary, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />
          <TextBlock Text="{Binding Lifecycle.HardwareAgeSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     Visibility="{Binding Lifecycle.HardwareAgeSummary, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- CPU / Memory -->
        <TextBlock Text="Processors" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding CpuCount, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Cpus}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Cores, Mode=OneWay}" /><Run Text="C/" /><Run Text="{Binding LogicalProcessors, Mode=OneWay}" /><Run Text="T @ " /><Run Text="{Binding ClockMhz, Mode=OneWay}" /><Run Text=" MHz" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding MemorySummary, StringFormat='Memory: {0}'}"
                   Visibility="{Binding TotalMemoryBytes, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding MemoryModules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding SlotLabel, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding CapacityBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text="  " /><Run Text="{Binding TypeDisplay, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Manufacturer, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding PartNumber, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- What the model line supports per the bundled vendor spec table (plus the operator override file). -->
        <TextBlock Text="{Binding SpecSheetSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                   ToolTip="{Binding Spec.Source}"
                   Visibility="{Binding SpecSheetSummary, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />

        <!-- Disks / Volumes -->
        <TextBlock Text="Storage" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding DiskCount, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Disks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap">
                <Run Text="{Binding Model, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text="  " /><Run Text="{Binding KindDisplay, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  [" /><Run Text="{Binding HealthDisplay, Mode=OneWay}" /><Run Text="]" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,2,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Foreground="{StaticResource MutedBrush}">
                <Run Text="{Binding Letter, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding FileSystem, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CapacityBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text=" total, " /><Run Text="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text=" free" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Best-effort drive-expansion estimate (chassis + board slots + disk count); null on VMs / when unknown. -->
        <TextBlock Text="{Binding ExpansionOutlook}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Visibility="{Binding ExpansionOutlook, Converter={StaticResource NotEmptyToVis}, FallbackValue=Collapsed}" />

        <!-- Network -->
        <TextBlock Text="Network adapters" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding AdapterCount, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Adapters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  [" /><Run Text="{Binding Mac, Mode=OneWay}" /><Run Text="]" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Users -->
        <TextBlock Text="Users" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding LocalAdministratorsDisplay, Converter={StaticResource NotEmptyToVis}}" />
        <TextBlock Text="{Binding LocalAdministratorsDisplay, StringFormat='Local Administrators: {0}'}" TextWrapping="Wrap"
                   Visibility="{Binding LocalAdministratorsDisplay, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding LogonSessions}" Margin="0,2,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="Signed in: " /><Run Text="{Binding Account, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding LogonType, Mode=OneWay}" /><Run Text=")" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Margin="0,4,0,0" IsExpanded="False"
                  Visibility="{Binding LocalAccountCount, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding LocalAccountCount, StringFormat='Local accounts ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding LocalAccounts}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Flags, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <Expander Margin="0,2,0,0" IsExpanded="False"
                  Visibility="{Binding UserProfiles, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding UserProfiles.Count, StringFormat='User profiles ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding UserProfiles}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding User, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastUse, Mode=OneWay, StringFormat='last used {0:yyyy-MM-dd}'}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding LocalPath, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <!-- Services / startup / tasks -->
        <Expander Margin="0,10,0,0" IsExpanded="False"
                  Visibility="{Binding ServiceCount, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ServicesSummary, StringFormat='Services — {0}'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding Services}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                  <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding StartMode}" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding Account}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <Expander Margin="0,2,0,0" IsExpanded="False"
                  Visibility="{Binding StartupItems, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding StartupItems.Count, StringFormat='Startup items ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding StartupItems}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}">
                  <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding User, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <Expander Margin="0,2,0,0" IsExpanded="False"
                  Visibility="{Binding ScheduledTasks, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding ScheduledTasks.Count, StringFormat='Scheduled tasks (non-Microsoft) ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding ScheduledTasks}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Path, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  runs as " /><Run Text="{Binding RunAs, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <!-- Peripherals -->
        <TextBlock Text="Peripherals" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding Gpus, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Gpus}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap">
                <Run Text="GPU: " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding VramBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" Foreground="{StaticResource MutedBrush}" /><Run Text="  driver " /><Run Text="{Binding DriverVersion, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Resolution, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Monitors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap">
                <Run Text="Monitor: " /><Run Text="{Binding Manufacturer, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Model, Mode=OneWay}" /><Run Text="  S/N " /><Run Text="{Binding Serial, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DiagonalInches, Mode=OneWay, StringFormat='{}{0} in'}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding Year, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Battery.Summary}"
                   Visibility="{Binding Battery, Converter={StaticResource NotEmptyToVis}}" />
        <TextBlock Text="{Binding ThermalTempC, StringFormat='Thermal zone: {0} °C'}"
                   Visibility="{Binding ThermalTempC, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Printers}" Margin="0,2,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="Printer queue: " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PortName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding HostAddress, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding DriverName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding QueuedJobs, Mode=OneWay, StringFormat='{}{0} queued', TargetNullValue=''}" /><Run Text="  " /><Run Text="{Binding PrinterState, Mode=OneWay}" Foreground="Firebrick" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Margin="0,2,0,0" IsExpanded="False"
                  Visibility="{Binding UsbDevices, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding UsbDevices.Count, StringFormat='USB devices ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding UsbDevices}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}">
                  <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Manufacturer, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding PnpClass, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <Expander Margin="0,2,0,0" IsExpanded="False"
                  Visibility="{Binding UsbStorageHistory, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding UsbStorageHistory.Count, StringFormat='USB storage history ({0})'}" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding UsbStorageHistory}" Margin="18,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding FriendlyName, Mode=OneWay}" /><Run Text="  S/N " /><Run Text="{Binding Serial, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <!-- Printer device (SNMP / IPP) -->
        <StackPanel Visibility="{Binding Printer, Converter={StaticResource NotEmptyToVis}}">
          <TextBlock Text="Printer" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding Printer.Status, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  device " /><Run Text="{Binding Printer.DeviceStatus, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Printer.IppState, Mode=OneWay, StringFormat='IPP: {0}', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Printer.ErrorStates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="Firebrick" FontWeight="SemiBold" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Printer.IppStateReasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="DarkGoldenrod" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Printer.DisplayText}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat='Display: {0}'}" Foreground="{StaticResource MutedBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Supplies" FontWeight="SemiBold" Margin="0,6,0,2"
                     Visibility="{Binding Printer.Supplies, Converter={StaticResource NotEmptyToVis}}" />
          <ItemsControl ItemsSource="{Binding Printer.Supplies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <ProgressBar Grid.Column="0" Height="12" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                               VerticalAlignment="Center" Margin="0,0,8,0">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar">
                        <Setter Property="Foreground" Value="#4CAF50" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter Property="Foreground" Value="#E67E22" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Foreground" Value="#C0392B" /></DataTrigger>
                          <DataTrigger Binding="{Binding Percent}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding Colorant, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding LevelDisplay}" HorizontalAlignment="Right">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter Property="Foreground" Value="#E67E22" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Foreground" Value="Firebrick" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                     Visibility="{Binding Printer.TotalPages, Converter={StaticResource NotEmptyToVis}}">
            <Run Text="Pages: " /><Run Text="{Binding Printer.TotalPages, Mode=OneWay, StringFormat='{}{0:N0}'}" /><Run Text=" " /><Run Text="{Binding Printer.PageCountUnit, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Visibility="{Binding Printer.QueuedJobs, Converter={StaticResource NotEmptyToVis}}">
            <Run Text="Queued on the printer: " /><Run Text="{Binding Printer.QueuedJobs, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
          <Expander Margin="0,2,0,0" IsExpanded="False"
                    Visibility="{Binding Printer.Jobs, Converter={StaticResource NotEmptyToVis}}">
            <Expander.Header>
              <TextBlock Text="{Binding Printer.Jobs.Count, StringFormat='Jobs on the printer ({0})'}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Printer.Jobs}" Margin="18,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Id, Mode=OneWay, StringFormat='#{0}'}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding User, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Impressions, Mode=OneWay, StringFormat='{}{0} pages', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <TextBlock Text="Queues on print servers" FontWeight="SemiBold" Margin="0,6,0,2"
                     Visibility="{Binding PrintServerQueues, Converter={StaticResource NotEmptyToVis}}" />
          <ItemsControl ItemsSource="{Binding PrintServerQueues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Trays" FontWeight="SemiBold" Margin="0,6,0,2"
                     Visibility="{Binding Printer.Trays, Converter={StaticResource NotEmptyToVis}}" />
          <ItemsControl ItemsSource="{Binding Printer.Trays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Media, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Percent, Mode=OneWay, StringFormat='{}{0} %', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Margin="0,2,0,0" IsExpanded="False"
                    Visibility="{Binding Printer.Alerts, Converter={StaticResource NotEmptyToVis}}">
            <Expander.Header>
              <TextBlock Text="{Binding Printer.Alerts.Count, StringFormat='Alerts ({0})'}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Printer.Alerts}" Margin="18,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Group, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding Code, Mode=OneWay, StringFormat='code {0}', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <ItemsControl ItemsSource="{Binding Printer.Covers}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}">
            <Run Text="{Binding Printer.SysName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Printer.Location, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Printer.Contact, Mode=OneWay}" /><Run Text="  firmware " /><Run Text="{Binding Printer.Firmware, Mode=OneWay}" /><Run Text="  up " /><Run Text="{Binding Printer.UptimeDisplay, Mode=OneWay}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="{Binding Printer.Description}" />
        </StackPanel>

        <!-- Network device (SNMP) -->
        <StackPanel Visibility="{Binding NetworkDevice, Converter={StaticResource NotEmptyToVis}}">
          <TextBlock Text="Network device" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
          <TextBlock TextWrapping="Wrap" Text="{Binding NetworkDevice.Description}" />
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding NetworkDevice.SysName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding NetworkDevice.Location, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding NetworkDevice.Contact, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
          </TextBlock>
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding NetworkDevice.InterfacesDisplay, Mode=OneWay}" /><Run Text="  firmware " /><Run Text="{Binding NetworkDevice.Firmware, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  up " /><Run Text="{Binding NetworkDevice.UptimeDisplay, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
          </TextBlock>
          <TextBlock Text="{Binding NetworkDevice.ObjectId, StringFormat='sysObjectID {0}', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- Software -->
        <Expander Margin="0,10,0,0" IsExpanded="False"
                  Visibility="{Binding SoftwareCount, Converter={StaticResource NotEmptyToVis}}">
          <Expander.Header>
            <TextBlock Text="{Binding SoftwareCount, StringFormat='Installed software ({0})'}" FontWeight="SemiBold" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding Software}" Margin="18,2,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Publisher}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <!-- Collector status -->
        <TextBlock Text="Collectors" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                   Visibility="{Binding Collectors.Count, Converter={StaticResource NotEmptyToVis}}" />
        <ItemsControl ItemsSource="{Binding Collectors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Error, Mode=OneWay}" Foreground="Firebrick" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

</ResourceDictionary>
