<Window x:Class="Marco.App.Views.ScanDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare scans — Marco" Height="600" Width="980" WindowStartupLocation="CenterOwner"
        Background="White">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: what changed, between which two scans. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,6">
      <TextBlock Text="{Binding HeaderSummary}" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{Binding SourcesText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
      <TextBox Width="240" DockPanel.Dock="Left" VerticalAlignment="Center"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Filter by machine, category, item, value or severity" />
      <TextBlock Text="filters every column" Foreground="{StaticResource MutedBrush}" FontSize="11"
                 VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Left" />
      <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" DockPanel.Dock="Right" />
      <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" DockPanel.Dock="Right" />
    </DockPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding RowsView}"
              AutoGenerateColumns="False" IsReadOnly="True"
              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
              RowHeight="24" SelectionMode="Extended" Background="White" RowBackground="White">
      <DataGrid.GroupStyle>
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="{x:Type GroupItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander IsExpanded="True" Background="{StaticResource PanelBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="2,2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} change(s)'}"
                                     Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                        </StackPanel>
                      </Expander.Header>
                      <ItemsPresenter />
                    </Expander>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </DataGrid.GroupStyle>
      <!-- Severity drives the row colour: red = posture regression, amber = worth a look. -->
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Regression">
              <Setter Property="Background" Value="#FDECEA" />
              <Setter Property="Foreground" Value="#8B1A12" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Notable">
              <Setter Property="Background" Value="#FFF8E1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="220" />
        <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="80" />
        <DataGridTextColumn Header="Before" Binding="{Binding OldValue}" Width="220" />
        <DataGridTextColumn Header="After" Binding="{Binding NewValue}" Width="220" />
        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
        <DataGridTextColumn Header="Matched by" Binding="{Binding MatchTag}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
