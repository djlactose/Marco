<Window x:Class="Marco.App.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add credential" Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="440" MinWidth="440"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Add" Width="80" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Mode -->
        <TextBlock Text="Credential type" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <RadioButton x:Name="WindowsModeRadio" Content="Windows (WMI)" IsChecked="True"
                       GroupName="mode" Checked="OnModeChanged" Margin="0,0,18,0" />
          <RadioButton x:Name="LinuxModeRadio" Content="Linux / Unix (SSH)"
                       GroupName="mode" Checked="OnModeChanged" />
        </StackPanel>

        <!-- Windows quick-fill presets -->
        <StackPanel x:Name="WindowsPresets">
          <TextBlock Text="Quick fill" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
          <WrapPanel Margin="0,0,0,8">
            <Button Content="AD domain" Click="OnPresetDomain" Margin="0,0,6,4" Padding="8,3" />
            <Button Content="Microsoft account" Click="OnPresetMicrosoft" Margin="0,0,6,4" Padding="8,3" />
            <Button Content="Entra / Intune" Click="OnPresetEntra" Margin="0,0,6,4" Padding="8,3" />
            <Button Content="Local admin" Click="OnPresetLocal" Margin="0,0,6,4" Padding="8,3" />
          </WrapPanel>
        </StackPanel>

        <!-- Fields -->
        <StackPanel>
          <DockPanel Margin="0,4">
            <TextBlock Text="Label" Width="110" VerticalAlignment="Center" />
            <TextBox x:Name="LabelBox" />
          </DockPanel>
          <DockPanel x:Name="ClientRow" Margin="0,4" Visibility="Collapsed">
            <TextBlock Text="Client" Width="110" VerticalAlignment="Center" />
            <ComboBox x:Name="ClientCombo"
                      ToolTip="Scans for a client try that client's credentials first, then shared ones. Another client's credentials are never used." />
          </DockPanel>
          <DockPanel x:Name="DomainRow" Margin="0,4">
            <TextBlock Text="Domain" Width="110" VerticalAlignment="Center" />
            <TextBox x:Name="DomainBox"
                     ToolTip="AD NetBIOS domain; the target computer name (or blank) for a local account; MicrosoftAccount or AzureAD for cloud logins." />
          </DockPanel>
          <DockPanel Margin="0,4">
            <TextBlock x:Name="UserLabel" Text="Username" Width="110" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" />
          </DockPanel>
          <DockPanel Margin="0,4">
            <TextBlock Text="Password" Width="110" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBoxCtrl" />
          </DockPanel>
          <TextBlock x:Name="PasswordKeepHint" Text="Leave blank to keep the current password."
                     Foreground="#6B7280" FontSize="11" Margin="110,0,0,0" Visibility="Collapsed" />
          <DockPanel x:Name="PortRow" Margin="0,4" Visibility="Collapsed">
            <TextBlock Text="SSH port" Width="110" VerticalAlignment="Center" />
            <TextBox x:Name="PortBox" Text="22" Width="80" HorizontalAlignment="Left" />
          </DockPanel>
        </StackPanel>

        <TextBlock x:Name="PresetHint" TextWrapping="Wrap" Foreground="#2A6FB0" FontSize="11" Margin="0,4"
                   Visibility="Collapsed" />
        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="11" Margin="0,2"
                   Text="Held as a SecureString; saved only if you persist profiles (DPAPI, this account only)." />

        <Separator Margin="0,8" />

        <!-- Test -->
        <TextBlock Text="Verify" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Test on host" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" x:Name="TestHostBox" VerticalContentAlignment="Center" />
          <Button  Grid.Column="2" x:Name="TestButton" Content="Test" Width="70" Margin="6,0,0,0" Click="OnTest" />
        </Grid>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed" />

        <!-- Windows setup directions -->
        <Expander x:Name="WindowsHelp" Header="How to enable a target (if WMI is blocked)" Margin="0,10,0,0">
          <Border Background="#F5F6F8" BorderBrush="#D9DCE1" BorderThickness="1" Padding="10" Margin="0,6,0,0">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333">
                Remote WMI with a <Bold>local</Bold> or <Bold>Microsoft/Entra</Bold> account is blocked by UAC
                token filtering (RDP works but WMI doesn't — that's the tell). Domain accounts are exempt. Run this
                once on each <Bold>target</Bold> (elevated), or push it fleet-wide via Intune:
              </TextBlock>
              <TextBox x:Name="SetupCommands" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0" Background="White" BorderThickness="1"
                       BorderBrush="#D9DCE1" Padding="6" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Copy commands" Click="OnCopySetup" Padding="8,3" Margin="0,0,6,0" />
                <TextBlock x:Name="CopyHint" Text="" VerticalAlignment="Center" Foreground="SeaGreen" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Expander>

        <!-- Linux note -->
        <Border x:Name="LinuxHelp" Background="#F5F6F8" BorderBrush="#D9DCE1" BorderThickness="1" Padding="10"
                Margin="0,10,0,0" Visibility="Collapsed">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333">
            Linux/Unix inventory connects over <Bold>SSH</Bold> with a username and password. The account needs
            shell login (not just SFTP). Some fields need root — e.g. the hardware serial from DMI — so results are
            best-effort as the SSH user. Key-based auth isn't supported yet. Ensure sshd is running and reachable
            on the port above.
          </TextBlock>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
