<Window x:Class="Marco.App.Views.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add credential" Height="560" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="440"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Add" Width="80" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Quick fill presets -->
        <TextBlock Text="Quick fill" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <Button Content="AD domain" Click="OnPresetDomain" Margin="0,0,6,4" Padding="8,3" />
          <Button Content="Microsoft account" Click="OnPresetMicrosoft" Margin="0,0,6,4" Padding="8,3" />
          <Button Content="Entra / Intune" Click="OnPresetEntra" Margin="0,0,6,4" Padding="8,3" />
          <Button Content="Local admin" Click="OnPresetLocal" Margin="0,0,6,4" Padding="8,3" />
        </WrapPanel>

        <!-- Fields -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Label" VerticalAlignment="Center" Margin="0,5" />
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LabelBox" Margin="0,5" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Domain" VerticalAlignment="Center" Margin="0,5" />
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="DomainBox" Margin="0,5"
                     ToolTip="AD NetBIOS domain; the target computer name (or blank) for a local account; MicrosoftAccount or AzureAD for cloud logins." />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,5" />
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="UserBox" Margin="0,5" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,5" />
          <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBoxCtrl" Margin="0,5" />
        </Grid>

        <TextBlock x:Name="PresetHint" TextWrapping="Wrap" Foreground="#2A6FB0" FontSize="11" Margin="0,4"
                   Visibility="Collapsed" />
        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="11" Margin="0,2"
                   Text="Held as a SecureString; saved only if you persist profiles (DPAPI, this account only)." />

        <Separator Margin="0,8" />

        <!-- Test -->
        <TextBlock Text="Verify" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Test on host" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" x:Name="TestHostBox" VerticalContentAlignment="Center" />
          <Button  Grid.Column="2" x:Name="TestButton" Content="Test" Width="70" Margin="6,0,0,0" Click="OnTest" />
        </Grid>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed" />

        <!-- Setup directions -->
        <Expander Header="How to enable a target (if WMI is blocked)" Margin="0,10,0,0" x:Name="HelpExpander">
          <Border Background="#F5F6F8" BorderBrush="#D9DCE1" BorderThickness="1" Padding="10" Margin="0,6,0,0">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333">
                Remote WMI with a <Bold>local</Bold> or <Bold>Microsoft/Entra</Bold> account is blocked by UAC
                token filtering (RDP works but WMI doesn't — that's the tell). Domain accounts are exempt. Run this
                once on each <Bold>target</Bold> (elevated), or push it fleet-wide via Intune:
              </TextBlock>
              <TextBox x:Name="SetupCommands" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0" Background="White" BorderThickness="1"
                       BorderBrush="#D9DCE1" Padding="6" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Copy commands" Click="OnCopySetup" Padding="8,3" Margin="0,0,6,0" />
                <TextBlock x:Name="CopyHint" Text="" VerticalAlignment="Center" Foreground="SeaGreen" FontSize="11" />
              </StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6B7280" Margin="0,8,0,0"
                         Text="Note: LocalAccountTokenFilterPolicy relaxes a lateral-movement protection — a deliberate choice. No reboot needed." />
            </StackPanel>
          </Border>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
