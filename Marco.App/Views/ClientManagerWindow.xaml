<Window x:Class="Marco.App.Views.ClientManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clients — Marco" Height="440" Width="560" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False" Background="White">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"
               Margin="0,0,0,8"
               Text="A client bundles its targets, report branding, and (locally) its credentials. Exported .marcoclient.json files carry targets and branding only — never credentials — so they are safe to share with teammates, who then assign their own credentials." />

    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="120">
      <Button Content="New…" Click="OnNew" Margin="0,0,0,6" />
      <Button Content="Edit…" Click="OnEdit" Margin="0,0,0,6" />
      <Button Content="Delete" Click="OnDelete" Margin="0,0,0,14" />
      <Button Content="Export…" Click="OnExport" Margin="0,0,0,6"
              ToolTip="Write a shareable .marcoclient.json (targets + branding, logo embedded — no credentials)" />
      <Button Content="Import…" Click="OnImport" Margin="0,0,0,14" />
      <Button Content="Close" IsCancel="True" />
    </StackPanel>

    <ListBox x:Name="ClientList" MouseDoubleClick="OnListDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
