<Window x:Class="Marco.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marco" SizeToContent="Height" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox x:Name="InputBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
