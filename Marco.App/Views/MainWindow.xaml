<Window x:Class="Marco.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Marco.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="760" Width="1280"
        Icon="/Assets/marco.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

  <DockPanel>

    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="14,10">
      <Grid>
        <StackPanel>
          <TextBlock Text="Marco" Foreground="White" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Agentless network discovery &amp; inventory — for networks you are authorized to administer."
                     Foreground="#DCEAF6" FontSize="12" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,2"
                     Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Hyperlink Command="{Binding UpdateActionCommand}" Foreground="#FFE9A0">
              <Run Text="{Binding UpdateText, Mode=OneWay}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock Text="{Binding StorageLocation}" Foreground="#CFE2F3" FontSize="11"
                     HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                     MaxWidth="520" ToolTip="{Binding StorageLocation}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Post-update "What's new" banner (shown once after an update applies). The link expands the release
         notes inline — the browser is only needed for the full release page. -->
    <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#E6D28C" BorderThickness="0,0,0,1" Padding="12,6"
            Visibility="{Binding WhatsNewVisible, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" MinWidth="0" Margin="8,0,0,0"
                VerticalAlignment="Top" ToolTip="Dismiss" Command="{Binding DismissWhatsNewCommand}" />
        <StackPanel>
          <TextBlock TextTrimming="CharacterEllipsis">
            <Run Text="🎉" /><Run Text=" " /><Run Text="{Binding WhatsNewText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " />
            <Hyperlink Command="{Binding OpenWhatsNewCommand}">
              <TextBlock>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="See what's new" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding WhatsNewExpanded}" Value="True">
                        <Setter Property="Text" Value="Hide" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Hyperlink>
          </TextBlock>
          <Border Margin="0,6,0,2" Background="White" BorderBrush="#E6D28C" BorderThickness="1"
                  CornerRadius="3" Padding="12,8"
                  Visibility="{Binding WhatsNewExpanded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding WhatsNewNotes}" TextWrapping="Wrap" />
              </ScrollViewer>
              <TextBlock Margin="0,8,0,0" FontSize="11">
                <Hyperlink Command="{Binding OpenWhatsNewReleaseCommand}">View the release on GitHub</Hyperlink>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusLine}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding UnknownDevicesText}" Foreground="#B8860B" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"
                     Visibility="{Binding UnknownDevicesText, Converter={StaticResource NotEmptyToVis}}"
                     ToolTip="Devices not in the blessed baseline. Filter the grid with 'NEW' to see them; right-click a row to trust it." />
          <Button Content="{Binding FleetComplianceText}" Command="{Binding OpenFleetHealthCommand}"
                  Padding="8,2" MinWidth="0" Margin="0,0,12,0"
                  Visibility="{Binding FleetComplianceText, Converter={StaticResource NotEmptyToVis}}"
                  ToolTip="Fleet compliance: average score, top failing rules, and the rule checklist" />
          <Button Content="Doctor…" Command="{Binding OpenDoctorCommand}" Padding="8,2" MinWidth="0" Margin="0,0,12,0"
                  Visibility="{Binding HasDoctorFindings, Converter={StaticResource BoolToVis}}"
                  ToolTip="Hosts that failed inventory, grouped by diagnosed cause, with copy-paste fixes" />
          <TextBlock Text="{Binding AliveCount, StringFormat='{}{0} alive'}" Foreground="SeaGreen" Margin="0,0,10,0" />
          <TextBlock Text="{Binding UnreachableCount, StringFormat='{}{0} down'}" Foreground="Gray" Margin="0,0,10,0" />
          <TextBlock Text="{Binding TotalCount, StringFormat='of {0}'}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <ProgressBar Grid.Column="2" Height="14" Minimum="0" Maximum="1"
                     Value="{Binding ProgressFraction}" IsIndeterminate="{Binding ProgressIndeterminate}" />
      </Grid>
    </Border>

    <!-- Body -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Left: scan configuration -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
          <StackPanel>
            <!-- Client engagement: selecting one prefills targets, scopes credentials, tags saved scans. -->
            <TextBlock Text="Client" Style="{StaticResource SectionHeader}" />
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="Clients…" Command="{Binding OpenClientManagerCommand}"
                      Margin="6,0,0,0" Padding="8,3" MinWidth="0"
                      ToolTip="Add, edit, share (.marcoclient.json) or import client profiles" />
              <Button DockPanel.Dock="Right" Content="💾" Command="{Binding SaveTargetsToClientCommand}"
                      Margin="6,0,0,0" Padding="6,3" MinWidth="0"
                      ToolTip="Save the current scan settings (targets, discovery options, concurrency, collectors) to the selected client" />
              <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding SelectedClientChoice}"
                        DisplayMemberPath="Display" IsEnabled="{Binding ClientSwitchEnabled}"
                        ToolTip="Switching clients loads that client's targets, discovery settings, baseline, history and branding, and clears the grid. '(No client)' is its own saved profile." />
            </DockPanel>

            <TextBlock Text="Targets" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="CIDR (10.0.0.0/24), range (10.0.0.1-50), IP, or hostname — one per line."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
            <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
            <Button Content="Load host file…" Command="{Binding BrowseHostFileCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="Suggested networks (this PC's adapters)" Margin="0,12,0,4"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <ItemsControl ItemsSource="{Binding SuggestedNetworks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cidr}" FontFamily="Consolas" />
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding AdapterName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Hint, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1" Content="Scan subnet" Padding="6,2" MinWidth="0" FontSize="11"
                              IsEnabled="{Binding IsScannableSubnet}"
                              ToolTip="Add this whole subnet (CIDR) to the targets"
                              Command="{Binding DataContext.AddSubnetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Content="+IP" Padding="6,2" MinWidth="0" FontSize="11" Margin="4,0,0,0"
                              ToolTip="Add just this adapter's own IP"
                              Command="{Binding DataContext.AddLocalIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,14" />

            <TextBlock Text="Discovery options" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="ICMP ping" IsChecked="{Binding IcmpEnabled}" Margin="0,3" />
            <CheckBox Content="TCP fallback (probe ports if ping fails)" IsChecked="{Binding TcpFallback}" Margin="0,3" />
            <CheckBox Content="Classify device type (ports, OUI, NBNS)" IsChecked="{Binding Classification}" Margin="0,3" />
            <CheckBox Content="Resolve names (DNS / NBNS)" IsChecked="{Binding ResolveNames}" Margin="0,3" />
            <CheckBox Content="Resolve MAC (ARP, on-subnet)" IsChecked="{Binding ResolveMac}" Margin="0,3" />
            <CheckBox Content="Show unreachable hosts" IsChecked="{Binding IncludeUnreachable}" Margin="0,3" />
            <CheckBox Content="Inventory automatically after discovery" IsChecked="{Binding AutoInventory}" Margin="0,3"
                      ToolTip="When discovery finishes, immediately inventory the alive hosts using the credentials below." />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Concurrency" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Text="{Binding Concurrency}" Width="60" ToolTip="{Binding ConcurrencyExplanation}" />
              <TextBlock Text="{Binding MaxConcurrency, Mode=OneWay, StringFormat='max {0} on this PC'}" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0"
                         ToolTip="{Binding ConcurrencyExplanation}" />
            </StackPanel>
            <TextBlock Text="Applies to discovery and inventory." Foreground="{StaticResource MutedBrush}"
                       FontSize="11" Margin="0,2,0,0" />

            <Separator Margin="0,14" />

            <TextBlock Text="Credentials (for inventory)" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Matched to each host's type (WMI or SSH) and tried in order; the first that authenticates is remembered. None = current session token (Windows hosts only)."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" MinHeight="60" MaxHeight="120">
              <ListBox ItemsSource="{Binding Credentials}" BorderThickness="0"
                       MouseDoubleClick="OnCredentialListDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Background="Transparent">
                      <Grid.ToolTip>
                        <StackPanel>
                          <TextBlock Text="{Binding Details}" />
                          <TextBlock Text="Double-click to edit." Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                      </Grid.ToolTip>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource TagBackgroundBrush}" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding KindTag, Converter={StaticResource NotEmptyToVis}}">
                          <TextBlock Text="{Binding KindTag}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="✕" Padding="4,0" MinWidth="0" Margin="4,0,0,0"
                              ToolTip="Remove"
                              Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Button Content="Add credential…" Command="{Binding AddCredentialCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <!-- Inventory collector checklist: collapsed by default, header carries the count. -->
            <Expander Margin="0,12,0,0" IsExpanded="False" ToolTip="Choose which inventory collectors run on each host. Applies to the next inventory run.">
              <Expander.Header>
                <TextBlock Text="{Binding CollectorSummary}" FontWeight="SemiBold" />
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Collectors}" Margin="4,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,2" ToolTip="{Binding ToolTipText}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" />
                        <Border Background="{StaticResource TagBackgroundBrush}" CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding PlatformTag, Converter={StaticResource NotEmptyToVis}}">
                          <TextBlock Text="{Binding PlatformTag}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <!-- Saved runs, newest first: completed scans are auto-saved (gzip) into Marco.Data\scans. -->
            <Expander Margin="0,8,0,0" IsExpanded="False"
                      ToolTip="Completed runs are saved here automatically. Double-click one to reopen it.">
              <Expander.Header>
                <TextBlock Text="{Binding HistorySummary}" FontWeight="SemiBold" />
              </Expander.Header>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White"
                      MinHeight="40" MaxHeight="180" Margin="4,4,0,0">
                <ListBox ItemsSource="{Binding History}" BorderThickness="0"
                         MouseDoubleClick="OnHistoryListDoubleClick">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <!-- ContextMenus sit outside the visual tree; Tag carries the window VM across, while the
                           menu's inherited DataContext stays the entry itself (the CommandParameter). -->
                      <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                      <Setter Property="ContextMenu">
                        <Setter.Value>
                          <ContextMenu>
                            <MenuItem Header="Open"
                                      Command="{Binding PlacementTarget.Tag.OpenHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Compare with current grid"
                                      Command="{Binding PlacementTarget.Tag.CompareWithCurrentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Compare with previous run"
                                      Command="{Binding PlacementTarget.Tag.CompareWithPreviousCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="Use as known-device baseline"
                                      Command="{Binding PlacementTarget.Tag.BlessHistoryEntryAsBaselineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Delete"
                                      Command="{Binding PlacementTarget.Tag.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Background="Transparent" ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <Border Background="{StaticResource TagBackgroundBrush}" CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PhaseTag, Converter={StaticResource NotEmptyToVis}}">
                              <TextBlock Text="{Binding PhaseTag}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding RangesText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CountsText, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Padding="4,0" MinWidth="0" Margin="4,0,0,0"
                                ToolTip="Delete this saved scan"
                                Command="{Binding DataContext.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Expander>

            <Separator Margin="0,14" />

            <!-- Enablement is driven by each command's CanExecute (IsRunning / IsCancelling), not by IsEnabled
                 bindings, so the buttons can never disagree with what a click would actually do. The first cell
                 is one button with two faces: Start when idle, Stop for the WHOLE run (discovery + chained
                 inventory — IsRunning spans the handoff so it can't flicker), "Stopping…" (disabled via
                 CanExecute) while a stop takes effect. Content/Command/Background swap via triggers only. -->
            <UniformGrid Rows="1" Columns="3">
              <Button>
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Content" Value="Start" />
                    <Setter Property="Command" Value="{Binding StartScanCommand}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Content" Value="Stop" />
                        <Setter Property="Command" Value="{Binding StopScanCommand}" />
                        <Setter Property="Background" Value="Firebrick" />
                      </DataTrigger>
                      <!-- After the IsRunning trigger on purpose: while stopping both are true and the last
                           writer per property wins — the label reads "Stopping…" while CanStopScan disables
                           the button. -->
                      <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                        <Setter Property="Content" Value="Stopping…" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Command="{Binding PauseResumeCommand}">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="6,0,6,0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Content" Value="Pause" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="Content" Value="Resume" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Clear" Command="{Binding ClearResultsCommand}" MinWidth="0" Padding="8,6" Margin="0" />
            </UniformGrid>

            <Separator Margin="0,14" />

            <TextBlock Text="About &amp; updates" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{Binding VersionDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <CheckBox Content="Include beta (pre-release) updates" IsChecked="{Binding IncludeBetaUpdates}" Margin="0,8,0,3"
                      ToolTip="Checked: update to the newest beta build (develop branch). Unchecked: stable releases only." />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock FontSize="11">
                <Hyperlink Command="{Binding CheckForUpdatesNowCommand}">Check for updates now</Hyperlink>
              </TextBlock>
              <TextBlock Text="{Binding UpdateCheckStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock FontSize="11" Margin="0,8,0,0">
              <Hyperlink Command="{Binding OpenBuyMeACoffeeCommand}">☕ Buy me a coffee</Hyperlink>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{StaticResource BorderBrush}" />

      <!-- Right: results + detail -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="240" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Filter -->
        <Border Grid.Row="0" Padding="10,8" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="filters every column" VerticalAlignment="Center" Margin="10,0,0,0"
                         Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <CheckBox Content="Group by IP block" IsChecked="{Binding GroupByBlock}" VerticalAlignment="Center"
                        Margin="18,0,0,0" ToolTip="One collapsible section per CIDR / range you entered" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Inventory selected" Command="{Binding InventorySelectedCommand}" />
              <Button Content="Inventory alive" Command="{Binding InventoryAliveCommand}"
                      Background="{StaticResource AccentBrush}" Foreground="White" />
              <Button Content="{Binding WakeMissingText}" Command="{Binding WakeMissingCommand}"
                      Visibility="{Binding WakeMissingText, Converter={StaticResource NotEmptyToVis}}"
                      ToolTip="Send Wake-on-LAN to hosts with a known MAC that aren't currently alive, then recheck them" />
              <Separator Style="{x:Null}" Width="1" Background="{StaticResource BorderBrush}" Margin="6,2" />
              <Button Content="Open scan…" Command="{Binding OpenScanCommand}"
                      ToolTip="Load a previously exported JSON scan back into the grid" />
              <Button Content="Compare…" Command="{Binding CompareCommand}"
                      ToolTip="Diff the current grid against the most recent saved scan of these ranges" />
              <Button Content="Report…" Command="{Binding GenerateReportCommand}"
                      ToolTip="Generate a branded HTML assessment report (executive summary, findings, asset appendix)" />
              <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
              <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Results grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding MachinesView}"
                  SelectedItem="{Binding SelectedMachine}"
                  MouseDoubleClick="OnMachineRowDoubleClick"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="24" SelectionMode="Single" Background="White"
                  RowBackground="White" AlternatingRowBackground="{StaticResource RowAltBrush}">
          <DataGrid.InputBindings>
            <KeyBinding Key="Return" Command="{Binding OpenMachineDetailCommand}" />
          </DataGrid.InputBindings>
          <!-- Row actions + baseline (a ContextMenu inherits the grid's DataContext = the VM). The "Actions"
               submenu is rebuilt per selection from HostActionRules. -->
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Actions" ItemsSource="{Binding HostActionItems}">
                <MenuItem.ItemContainerStyle>
                  <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="Command" Value="{Binding DataContext.RunHostActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                  </Style>
                </MenuItem.ItemContainerStyle>
              </MenuItem>
              <Separator />
              <MenuItem Header="Trust this device (add to baseline)"
                        Command="{Binding TrustDeviceCommand}" CommandParameter="{Binding SelectedMachine}" />
              <MenuItem Header="Trust all unknown devices" Command="{Binding TrustAllUnknownCommand}" />
              <MenuItem Header="Bless current results as baseline" Command="{Binding BlessCurrentAsBaselineCommand}"
                        ToolTip="Future scans flag devices not in this set as NEW" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <!-- One collapsible section per target block (see MainViewModel.ApplyGrouping). -->
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="{x:Type GroupItem}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="{StaticResource PanelBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                          <Expander.Header>
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontFamily="Consolas" />
                              <TextBlock Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0">
                                <TextBlock.Text>
                                  <MultiBinding Converter="{StaticResource GroupSummary}">
                                    <Binding Path="Items" />
                                    <Binding Path="ItemCount" />
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </StackPanel>
                          </Expander.Header>
                          <ItemsPresenter />
                        </Expander>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                           Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                           ToolTip="{Binding StatusDetail}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120"
                                SortMemberPath="AddressSortKey" SortDirection="Ascending" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
            <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            <DataGridTextColumn Header="Known" Binding="{Binding BaselineTag}" Width="55">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BaselineTag}" Value="NEW">
                      <Setter Property="Background" Value="#FFF3CD" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BaselineTag}" Value="NEW?">
                      <Setter Property="Background" Value="#FFF8E1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BaselineTag}" Value="✓">
                      <Setter Property="Foreground" Value="SeaGreen" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Activity" Binding="{Binding CurrentActivity}" Width="170" />
            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="130" />
            <DataGridTextColumn Header="MAC" Binding="{Binding PrimaryMac}" Width="130" />
            <DataGridTextColumn Header="Virtual" Binding="{Binding IsVirtual}" Width="60" />
            <DataGridTextColumn Header="User" Binding="{Binding System.CurrentOrLastUser}" Width="150" />
            <DataGridTextColumn Header="Manufacturer" Binding="{Binding System.Manufacturer}" Width="130" />
            <DataGridTextColumn Header="Model" Binding="{Binding System.Model}" Width="130" />
            <DataGridTextColumn Header="OS" Binding="{Binding Os.Caption}" Width="170" />
            <DataGridTextColumn Header="OS Build" Binding="{Binding Os.Build}" Width="70" />
            <DataGridTextColumn Header="OS Version" Binding="{Binding Os.Version}" Width="90" />
            <DataGridTextColumn Header="Release" Binding="{Binding Updates.DisplayVersion}" Width="65" />
            <DataGridTextColumn Header="Reboot?" Binding="{Binding Updates.PendingRebootDisplay}" Width="60" />
            <DataGridTextColumn Header="Antivirus" Binding="{Binding AntivirusSummary}" Width="160" />
            <DataGridTextColumn Header="Compliance" Binding="{Binding ComplianceDisplay}" Width="105" />
            <DataGridTextColumn Header="OS EOL" Binding="{Binding LifecycleDisplay}" Width="85" />
            <DataGridTextColumn Header="RAM"
                                Binding="{Binding TotalMemoryBytes, Converter={StaticResource BytesToGb}}" Width="70" />
            <DataGridTextColumn Header="CPUs" Binding="{Binding CpuCount}" Width="55" />
            <DataGridTextColumn Header="Software" Binding="{Binding SoftwareCount}" Width="70" />
            <DataGridTextColumn Header="FQDN" Binding="{Binding Fqdn}" Width="200" />
            <DataGridTextColumn Header="Discovery" Binding="{Binding DiscoveryMethod}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource BorderBrush}" />

        <!-- Detail view -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <ContentControl Content="{Binding SelectedMachine}"
                            ContentTemplate="{StaticResource MachineDetailTemplate}" />
            <Button Content="Open full screen" Command="{Binding OpenMachineDetailCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,20,0"
                    Padding="8,3" MinWidth="0" FontSize="11"
                    ToolTip="Open this machine's details in a full-screen window (double-click a row or press Enter)" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
