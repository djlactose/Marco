<Window x:Class="Marco.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Marco.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="760" Width="1280"
        Icon="/Assets/marco.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

  <DockPanel>

    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="14,10">
      <Grid>
        <StackPanel>
          <TextBlock Text="Marco" Foreground="White" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Agentless network discovery &amp; inventory — for networks you are authorized to administer."
                     Foreground="#DCEAF6" FontSize="12" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock HorizontalAlignment="Right" FontSize="11" Margin="0,0,0,2"
                     Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Hyperlink Command="{Binding UpdateActionCommand}" Foreground="#FFE9A0">
              <Run Text="{Binding UpdateText, Mode=OneWay}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock Text="{Binding StorageLocation}" Foreground="#CFE2F3" FontSize="11"
                     HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                     MaxWidth="520" ToolTip="{Binding StorageLocation}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Post-update "What's new" banner (shown once after an update applies) -->
    <Border DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#E6D28C" BorderThickness="0,0,0,1" Padding="12,4"
            Visibility="{Binding WhatsNewVisible, Converter={StaticResource BoolToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" MinWidth="0" Margin="8,0,0,0"
                ToolTip="Dismiss" Command="{Binding DismissWhatsNewCommand}" />
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding WhatsNewText, Mode=OneWay}" />
          <Hyperlink Command="{Binding OpenWhatsNewCommand}">What's new</Hyperlink>
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusLine}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding AliveCount, StringFormat='{}{0} alive'}" Foreground="SeaGreen" Margin="0,0,10,0" />
          <TextBlock Text="{Binding UnreachableCount, StringFormat='{}{0} down'}" Foreground="Gray" Margin="0,0,10,0" />
          <TextBlock Text="{Binding TotalCount, StringFormat='of {0}'}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
          <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <ProgressBar Grid.Column="2" Height="14" Minimum="0" Maximum="1"
                     Value="{Binding ProgressFraction}" IsIndeterminate="{Binding ProgressIndeterminate}" />
      </Grid>
    </Border>

    <!-- Body -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Left: scan configuration -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
          <StackPanel>
            <TextBlock Text="Targets" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="CIDR (10.0.0.0/24), range (10.0.0.1-50), IP, or hostname — one per line."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
            <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
            <Button Content="Load host file…" Command="{Binding BrowseHostFileCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="Suggested networks (this PC's adapters)" Margin="0,12,0,4"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <ItemsControl ItemsSource="{Binding SuggestedNetworks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cidr}" FontFamily="Consolas" />
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding AdapterName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Hint, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1" Content="Scan subnet" Padding="6,2" MinWidth="0" FontSize="11"
                              IsEnabled="{Binding IsScannableSubnet}"
                              ToolTip="Add this whole subnet (CIDR) to the targets"
                              Command="{Binding DataContext.AddSubnetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Content="+IP" Padding="6,2" MinWidth="0" FontSize="11" Margin="4,0,0,0"
                              ToolTip="Add just this adapter's own IP"
                              Command="{Binding DataContext.AddLocalIpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,14" />

            <TextBlock Text="Discovery options" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="ICMP ping" IsChecked="{Binding IcmpEnabled}" Margin="0,3" />
            <CheckBox Content="TCP fallback (probe ports if ping fails)" IsChecked="{Binding TcpFallback}" Margin="0,3" />
            <CheckBox Content="Classify device type (ports, OUI, NBNS)" IsChecked="{Binding Classification}" Margin="0,3" />
            <CheckBox Content="Resolve names (DNS / NBNS)" IsChecked="{Binding ResolveNames}" Margin="0,3" />
            <CheckBox Content="Resolve MAC (ARP, on-subnet)" IsChecked="{Binding ResolveMac}" Margin="0,3" />
            <CheckBox Content="Show unreachable hosts" IsChecked="{Binding IncludeUnreachable}" Margin="0,3" />
            <CheckBox Content="Inventory automatically after discovery" IsChecked="{Binding AutoInventory}" Margin="0,3"
                      ToolTip="When discovery finishes, immediately inventory the alive hosts using the credentials below." />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Concurrency" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Text="{Binding Concurrency}" Width="60" />
            </StackPanel>

            <Separator Margin="0,14" />

            <TextBlock Text="Credentials (for inventory)" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Matched to each host's type (WMI or SSH) and tried in order; the first that authenticates is remembered. None = current session token (Windows hosts only)."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" MinHeight="60" MaxHeight="120">
              <ListBox ItemsSource="{Binding Credentials}" BorderThickness="0"
                       MouseDoubleClick="OnCredentialListDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Background="Transparent">
                      <Grid.ToolTip>
                        <StackPanel>
                          <TextBlock Text="{Binding Details}" />
                          <TextBlock Text="Double-click to edit." Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                      </Grid.ToolTip>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource TagBackgroundBrush}" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding KindTag, Converter={StaticResource NotEmptyToVis}}">
                          <TextBlock Text="{Binding KindTag}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="✕" Padding="4,0" MinWidth="0" Margin="4,0,0,0"
                              ToolTip="Remove"
                              Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Button Content="Add credential…" Command="{Binding AddCredentialCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />

            <!-- Inventory collector checklist: collapsed by default, header carries the count. -->
            <Expander Margin="0,12,0,0" IsExpanded="False" ToolTip="Choose which inventory collectors run on each host. Applies to the next inventory run.">
              <Expander.Header>
                <TextBlock Text="{Binding CollectorSummary}" FontWeight="SemiBold" />
              </Expander.Header>
              <ItemsControl ItemsSource="{Binding Collectors}" Margin="4,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,2" ToolTip="{Binding ToolTipText}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" />
                        <Border Background="{StaticResource TagBackgroundBrush}" CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding PlatformTag, Converter={StaticResource NotEmptyToVis}}">
                          <TextBlock Text="{Binding PlatformTag}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Separator Margin="0,14" />

            <!-- Enablement is driven by each command's CanExecute (IsScanning / IsCancelling), not by IsEnabled
                 bindings, so the buttons can never disagree with what a click would actually do. One row of four
                 equal cells: at the panel's width a WrapPanel pushed Clear onto a second, easily-missed line. -->
            <UniformGrid Rows="1" Columns="4">
              <Button Content="Start" Command="{Binding StartScanCommand}" MinWidth="0" Padding="8,6"
                      Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
              <Button Command="{Binding PauseResumeCommand}">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Content" Value="Pause" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPaused}" Value="True">
                        <Setter Property="Content" Value="Resume" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="0" Padding="8,6" />
              <Button Content="Clear" Command="{Binding ClearResultsCommand}" MinWidth="0" Padding="8,6" Margin="0" />
            </UniformGrid>

            <Separator Margin="0,14" />

            <TextBlock Text="About &amp; updates" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{Binding VersionDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <CheckBox Content="Include beta (pre-release) updates" IsChecked="{Binding IncludeBetaUpdates}" Margin="0,8,0,3"
                      ToolTip="Checked: update to the newest beta build (develop branch). Unchecked: stable releases only." />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock FontSize="11">
                <Hyperlink Command="{Binding CheckForUpdatesNowCommand}">Check for updates now</Hyperlink>
              </TextBlock>
              <TextBlock Text="{Binding UpdateCheckStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock FontSize="11" Margin="0,8,0,0">
              <Hyperlink Command="{Binding OpenBuyMeACoffeeCommand}">☕ Buy me a coffee</Hyperlink>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="{StaticResource BorderBrush}" />

      <!-- Right: results + detail -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="240" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Filter -->
        <Border Grid.Row="0" Padding="10,8" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="filters every column" VerticalAlignment="Center" Margin="10,0,0,0"
                         Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <CheckBox Content="Group by IP block" IsChecked="{Binding GroupByBlock}" VerticalAlignment="Center"
                        Margin="18,0,0,0" ToolTip="One collapsible section per CIDR / range you entered" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Inventory selected" Command="{Binding InventorySelectedCommand}" />
              <Button Content="Inventory alive" Command="{Binding InventoryAliveCommand}"
                      Background="{StaticResource AccentBrush}" Foreground="White" />
              <Separator Style="{x:Null}" Width="1" Background="{StaticResource BorderBrush}" Margin="6,2" />
              <Button Content="Open scan…" Command="{Binding OpenScanCommand}"
                      ToolTip="Load a previously exported JSON scan back into the grid" />
              <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
              <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Results grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding MachinesView}"
                  SelectedItem="{Binding SelectedMachine}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="24" SelectionMode="Single" Background="White"
                  RowBackground="White" AlternatingRowBackground="{StaticResource RowAltBrush}">
          <!-- One collapsible section per target block (see MainViewModel.ApplyGrouping). -->
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="{x:Type GroupItem}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="{StaticResource PanelBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                          <Expander.Header>
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontFamily="Consolas" />
                              <TextBlock Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0">
                                <TextBlock.Text>
                                  <MultiBinding Converter="{StaticResource GroupSummary}">
                                    <Binding Path="Items" />
                                    <Binding Path="ItemCount" />
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </StackPanel>
                          </Expander.Header>
                          <ItemsPresenter />
                        </Expander>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="26" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="10" Height="10" HorizontalAlignment="Center"
                           Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                           ToolTip="{Binding StatusDetail}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120"
                                SortMemberPath="AddressSortKey" SortDirection="Ascending" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
            <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="100" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="130" />
            <DataGridTextColumn Header="MAC" Binding="{Binding PrimaryMac}" Width="130" />
            <DataGridTextColumn Header="Virtual" Binding="{Binding IsVirtual}" Width="60" />
            <DataGridTextColumn Header="User" Binding="{Binding System.CurrentOrLastUser}" Width="150" />
            <DataGridTextColumn Header="Manufacturer" Binding="{Binding System.Manufacturer}" Width="130" />
            <DataGridTextColumn Header="Model" Binding="{Binding System.Model}" Width="130" />
            <DataGridTextColumn Header="OS" Binding="{Binding Os.Caption}" Width="170" />
            <DataGridTextColumn Header="OS Build" Binding="{Binding Os.Build}" Width="70" />
            <DataGridTextColumn Header="OS Version" Binding="{Binding Os.Version}" Width="90" />
            <DataGridTextColumn Header="Release" Binding="{Binding Updates.DisplayVersion}" Width="65" />
            <DataGridTextColumn Header="Reboot?" Binding="{Binding Updates.PendingRebootDisplay}" Width="60" />
            <DataGridTextColumn Header="Antivirus" Binding="{Binding AntivirusSummary}" Width="160" />
            <DataGridTextColumn Header="RAM"
                                Binding="{Binding TotalMemoryBytes, Converter={StaticResource BytesToGb}}" Width="70" />
            <DataGridTextColumn Header="CPUs" Binding="{Binding CpuCount}" Width="55" />
            <DataGridTextColumn Header="Software" Binding="{Binding SoftwareCount}" Width="70" />
            <DataGridTextColumn Header="FQDN" Binding="{Binding Fqdn}" Width="200" />
            <DataGridTextColumn Header="Discovery" Binding="{Binding DiscoveryMethod}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{StaticResource BorderBrush}" />

        <!-- Detail view -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <ContentControl Content="{Binding SelectedMachine}">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusDetail}" Foreground="Firebrick" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding StatusDetail, Converter={StaticResource NotEmptyToVis}}" />

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                      <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Identity" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Address, StringFormat='IP: {0}'}" />
                        <TextBlock Text="{Binding Fqdn, StringFormat='FQDN: {0}'}"
                                   Visibility="{Binding Fqdn, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding PrimaryMac, StringFormat='MAC: {0}'}"
                                   Visibility="{Binding PrimaryMac, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Vendor, StringFormat='Vendor: {0}'}"
                                   Visibility="{Binding Vendor, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding DeviceType, StringFormat='Type: {0}'}" />
                        <TextBlock Text="{Binding System.Domain, StringFormat='Domain: {0}'}"
                                   Visibility="{Binding System.Domain, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Discovery" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding DiscoveryMethod, StringFormat='Method: {0}'}" />
                        <TextBlock Text="{Binding IcmpTtl, StringFormat='TTL: {0}'}"
                                   Visibility="{Binding IcmpTtl, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding OpenPortsDisplay, StringFormat='Open ports: {0}'}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding OpenPortsDisplay, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding LastScanned, StringFormat='Scanned: {0:HH:mm:ss}'}" />
                        <TextBlock Text="{Binding Os.Caption, StringFormat='OS: {0}'}"
                                   Visibility="{Binding Os.Caption, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                    </UniformGrid>

                    <!-- Inventory (populated after Inventory selected/alive) -->
                    <Separator Margin="0,10" />

                    <UniformGrid Columns="2">
                      <StackPanel Margin="0,0,20,0"
                                  Visibility="{Binding System.Manufacturer, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="System" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding System.Manufacturer, StringFormat='Manufacturer: {0}'}" />
                        <TextBlock Text="{Binding System.Model, StringFormat='Model: {0}'}" />
                        <TextBlock Text="{Binding System.SerialNumber, StringFormat='Serial: {0}'}" />
                        <TextBlock Text="{Binding System.ChassisType, StringFormat='Chassis: {0}'}" />
                        <TextBlock Text="{Binding System.BiosVersion, StringFormat='BIOS: {0}'}" />
                        <TextBlock Text="{Binding System.MotherboardModel, StringFormat='Board: {0}'}" />
                        <TextBlock Text="{Binding System.CurrentOrLastUser, StringFormat='User: {0}'}"
                                   Visibility="{Binding System.CurrentOrLastUser, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                      <StackPanel Visibility="{Binding Os.Caption, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="Operating system" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Os.Caption}" />
                        <TextBlock Text="{Binding Os.Version, StringFormat='Version {0}'}" />
                        <TextBlock Text="{Binding Os.Build, StringFormat='Build {0}'}" />
                        <TextBlock Text="{Binding Os.Architecture}" />
                        <TextBlock Text="{Binding Os.InstallDate, StringFormat='Installed {0:yyyy-MM-dd}'}" />
                        <TextBlock Text="{Binding Os.UptimeDisplay, StringFormat='Uptime {0}'}"
                                   Visibility="{Binding Os.UptimeDisplay, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                    </UniformGrid>

                    <!-- Updates & servicing / Security posture -->
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                      <StackPanel Margin="0,0,20,0"
                                  Visibility="{Binding Updates.HasData, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="Updates &amp; servicing" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Updates.BuildSummary}" TextWrapping="Wrap"
                                   Visibility="{Binding Updates.BuildSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.EditionId, StringFormat='Edition: {0}'}"
                                   Visibility="{Binding Updates.EditionId, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.HotfixSummary}"
                                   Visibility="{Binding Updates.HotfixSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.PendingRebootReasons, StringFormat='Pending reboot: {0}'}" Foreground="Firebrick" FontWeight="SemiBold"
                                   Visibility="{Binding Updates.PendingRebootReasons, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.WsusDisplay, StringFormat='WSUS: {0}'}"
                                   Visibility="{Binding Updates.WsusDisplay, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.AutoUpdateOption, StringFormat='Automatic Updates: {0}'}"
                                   Visibility="{Binding Updates.AutoUpdateOption, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Updates.Notes}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding Updates.Notes, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                      <StackPanel Visibility="{Binding Security.HasData, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="Security posture" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AntivirusSummary, StringFormat='Antivirus: {0}'}" TextWrapping="Wrap"
                                   Visibility="{Binding AntivirusSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.DefenderSummary, StringFormat='Defender: {0}'}" TextWrapping="Wrap"
                                   Visibility="{Binding Security.DefenderSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.FirewallSummary, StringFormat='Firewall: {0}'}"
                                   Visibility="{Binding Security.FirewallSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.BitLockerSummary, StringFormat='BitLocker: {0}'}" TextWrapping="Wrap"
                                   Visibility="{Binding Security.BitLockerSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.PlatformSummary, StringFormat='Platform: {0}'}"
                                   Visibility="{Binding Security.PlatformSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.RdpSummary, StringFormat='Remote Desktop: {0}'}"
                                   Visibility="{Binding Security.RdpSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.SmbSummary, StringFormat='SMB: {0}'}"
                                   Visibility="{Binding Security.SmbSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.UacSummary, StringFormat='UAC: {0}'}"
                                   Visibility="{Binding Security.UacSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.VbsSummary, StringFormat='VBS: {0}'}"
                                   Visibility="{Binding Security.VbsSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.LapsSummary, StringFormat='LAPS: {0}'}"
                                   Visibility="{Binding Security.LapsSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="{Binding Security.Notes}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding Security.Notes, Converter={StaticResource NotEmptyToVis}}" />
                      </StackPanel>
                    </UniformGrid>

                    <!-- CPU / Memory -->
                    <TextBlock Text="Processors" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding CpuCount, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Cpus}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Cores, Mode=OneWay}" /><Run Text="C/" /><Run Text="{Binding LogicalProcessors, Mode=OneWay}" /><Run Text="T @ " /><Run Text="{Binding ClockMhz, Mode=OneWay}" /><Run Text=" MHz" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding TotalMemoryGb, StringFormat='Memory: {0} GB'}"
                               Visibility="{Binding TotalMemoryBytes, Converter={StaticResource NotEmptyToVis}}" />

                    <!-- Disks / Volumes -->
                    <TextBlock Text="Storage" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding DiskCount, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Disks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Model, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text="  " /><Run Text="{Binding KindDisplay, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  [" /><Run Text="{Binding HealthDisplay, Mode=OneWay}" /><Run Text="]" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Volumes}" Margin="0,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Foreground="{StaticResource MutedBrush}">
                            <Run Text="{Binding Letter, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding FileSystem, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CapacityBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text=" total, " /><Run Text="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" /><Run Text=" free" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Network -->
                    <TextBlock Text="Network adapters" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding AdapterCount, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Adapters}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  [" /><Run Text="{Binding Mac, Mode=OneWay}" /><Run Text="]" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Users -->
                    <TextBlock Text="Users" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding LocalAdministratorsDisplay, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Text="{Binding LocalAdministratorsDisplay, StringFormat='Local Administrators: {0}'}" TextWrapping="Wrap"
                               Visibility="{Binding LocalAdministratorsDisplay, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding LogonSessions}" Margin="0,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <Run Text="Signed in: " /><Run Text="{Binding Account, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding LogonType, Mode=OneWay}" /><Run Text=")" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Margin="0,4,0,0" IsExpanded="False"
                              Visibility="{Binding LocalAccountCount, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding LocalAccountCount, StringFormat='Local accounts ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding LocalAccounts}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Flags, Mode=OneWay}" />
                              </TextBlock>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Expander Margin="0,2,0,0" IsExpanded="False"
                              Visibility="{Binding UserProfiles, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding UserProfiles.Count, StringFormat='User profiles ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding UserProfiles}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock>
                              <Run Text="{Binding User, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastUse, Mode=OneWay, StringFormat='last used {0:yyyy-MM-dd}'}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding LocalPath, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>

                    <!-- Services / startup / tasks -->
                    <Expander Margin="0,10,0,0" IsExpanded="False"
                              Visibility="{Binding ServiceCount, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ServicesSummary, StringFormat='Services — {0}'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Services}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                              <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource MutedBrush}" />
                              <TextBlock Grid.Column="2" Text="{Binding StartMode}" Foreground="{StaticResource MutedBrush}" />
                              <TextBlock Grid.Column="3" Text="{Binding Account}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Expander Margin="0,2,0,0" IsExpanded="False"
                              Visibility="{Binding StartupItems, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding StartupItems.Count, StringFormat='Startup items ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding StartupItems}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}">
                              <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding User, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Expander Margin="0,2,0,0" IsExpanded="False"
                              Visibility="{Binding ScheduledTasks, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding ScheduledTasks.Count, StringFormat='Scheduled tasks (non-Microsoft) ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding ScheduledTasks}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Path, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  runs as " /><Run Text="{Binding RunAs, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>

                    <!-- Peripherals -->
                    <TextBlock Text="Peripherals" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding Gpus, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Gpus}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="GPU: " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding VramBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" Foreground="{StaticResource MutedBrush}" /><Run Text="  driver " /><Run Text="{Binding DriverVersion, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding Resolution, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Monitors}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="Monitor: " /><Run Text="{Binding Manufacturer, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Model, Mode=OneWay}" /><Run Text="  S/N " /><Run Text="{Binding Serial, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DiagonalInches, Mode=OneWay, StringFormat='{}{0} in'}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding Year, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Battery.Summary}"
                               Visibility="{Binding Battery, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Text="{Binding ThermalTempC, StringFormat='Thermal zone: {0} °C'}"
                               Visibility="{Binding ThermalTempC, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Printers}" Margin="0,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="Printer: " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PortName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding HostAddress, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding DriverName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Margin="0,2,0,0" IsExpanded="False"
                              Visibility="{Binding UsbDevices, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding UsbDevices.Count, StringFormat='USB devices ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding UsbDevices}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}">
                              <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Manufacturer, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /><Run Text="  " /><Run Text="{Binding PnpClass, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Expander Margin="0,2,0,0" IsExpanded="False"
                              Visibility="{Binding UsbStorageHistory, Converter={StaticResource NotEmptyToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding UsbStorageHistory.Count, StringFormat='USB storage history ({0})'}" />
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding UsbStorageHistory}" Margin="18,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding FriendlyName, Mode=OneWay}" /><Run Text="  S/N " /><Run Text="{Binding Serial, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>

                    <!-- Software -->
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Text="{Binding SoftwareCount, StringFormat='Installed software ({0})'}"
                               Visibility="{Binding SoftwareCount, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Software}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Publisher}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Collector status -->
                    <TextBlock Text="Collectors" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"
                               Visibility="{Binding Collectors.Count, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Collectors}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Error, Mode=OneWay}" Foreground="Firebrick" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
