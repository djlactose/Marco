<Window x:Class="Marco.App.Views.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate report" Height="300" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Generate" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>

    <StackPanel>
      <DockPanel Margin="0,4">
        <TextBlock Text="Client / branding" Width="120" VerticalAlignment="Center" />
        <ComboBox x:Name="ClientCombo" DisplayMemberPath="Display" />
      </DockPanel>
      <DockPanel Margin="0,4">
        <TextBlock Text="Report title" Width="120" VerticalAlignment="Center" />
        <TextBox x:Name="TitleBox" />
      </DockPanel>
      <CheckBox x:Name="AppendixCheck" Content="Include full asset appendix" IsChecked="True" Margin="120,8,0,0" />
      <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="11" Margin="0,12,0,0"
                 Text="Produces a self-contained HTML report (executive summary, OS chart, prioritized findings, asset table) and opens it in your browser. Use the browser's Print → Save as PDF for a PDF." />
    </StackPanel>
  </DockPanel>
</Window>
